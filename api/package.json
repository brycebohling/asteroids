{
  "name": "asteroids-api",
  "version": "1.0.0",
  "description": "Leaderboard API for the Asteroids game \u2014 Cloudflare Worker + D1, no runtime dependencies",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply leaderboard --local",
    "migrate:remote": "wrangler d1 migrations apply leaderboard --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "~5.7.0",
    "wrangler": "^4.0.0"
  }
}
